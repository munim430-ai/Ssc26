# Copy to .env.local and fill in real values. Never commit .env.local.
# Same 5 values must be entered into Vercel → Settings → Environment Variables.

# Admin login password (you choose)
ADMIN_PASSWORD=changeme

# Random 32+ char hex; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-random-32-plus-char-hex

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3001
